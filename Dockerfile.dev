FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Use conda Python and install the venv at /opt/venv (outside /app).
# /app is bind-mounted at runtime, so anything under /app would be wiped.
# /opt/venv survives the bind mount — packages are ready immediately on start.
ENV UV_PYTHON=/opt/conda/bin/python \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/conda/bin:$PATH

COPY pyproject.toml uv.lock ./
RUN uv venv /opt/venv && uv sync --frozen --group dev --no-install-project

# Create non-root user and grant write access to the venv so postCreateCommand
# can install the local project package (uv sync without --no-install-project).
RUN useradd -m -s /bin/bash vscode \
    && mkdir -p /home/vscode/.vscode-server \
    && chown -R vscode:vscode /home/vscode/.vscode-server /opt/venv
